{
  "name": "@llmops/sdk",
  "version": "1.0.0-beta.23",
  "description": "An LLMOps toolkit for TypeScript applications",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://llmops.build",
  "bugs": {
    "url": "https://github.com/llmops-build/llmops/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llmops-build/llmops.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "llmops",
    "ai",
    "llm",
    "typescript",
    "openai"
  ],
  "author": "chtushar",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agents": {
      "import": {
        "types": "./dist/agents.d.mts",
        "default": "./dist/agents.mjs"
      },
      "require": {
        "types": "./dist/agents.d.cts",
        "default": "./dist/agents.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.mts",
        "default": "./dist/hono.mjs"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/nextjs.d.mts",
        "default": "./dist/nextjs.mjs"
      },
      "require": {
        "types": "./dist/nextjs.d.cts",
        "default": "./dist/nextjs.cjs"
      }
    },
    "./store/pg": {
      "import": {
        "types": "./dist/store/pg.d.mts",
        "default": "./dist/store/pg.mjs"
      },
      "require": {
        "types": "./dist/store/pg.d.cts",
        "default": "./dist/store/pg.cjs"
      }
    },
    "./store/d1": {
      "import": {
        "types": "./dist/store/d1.d.mts",
        "default": "./dist/store/d1.mjs"
      },
      "require": {
        "types": "./dist/store/d1.d.cts",
        "default": "./dist/store/d1.cjs"
      }
    },
    "./store/sqlite": {
      "import": {
        "types": "./dist/store/sqlite.d.mts",
        "default": "./dist/store/sqlite.mjs"
      },
      "require": {
        "types": "./dist/store/sqlite.d.cts",
        "default": "./dist/store/sqlite.cjs"
      }
    },
    "./eval": {
      "import": {
        "types": "./dist/eval.d.mts",
        "default": "./dist/eval.mjs"
      },
      "require": {
        "types": "./dist/eval.d.cts",
        "default": "./dist/eval.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/types.mjs"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@llmops/app": "workspace:^",
    "@llmops/core": "workspace:^"
  },
  "peerDependencies": {
    "pg": "*",
    "better-sqlite3": "*"
  },
  "peerDependenciesMeta": {
    "pg": { "optional": true },
    "better-sqlite3": { "optional": true }
  },
  "devDependencies": {
    "@tsqx/cli": "^0.0.5",
    "@tsqx/kit": "^0.0.5",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.15.6",
    "hono": "^4.7.0"
  }
}
