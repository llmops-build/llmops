{
  "name": "@llmops/cli",
  "version": "1.0.0-beta.19",
  "type": "module",
  "description": "LLMOps CLI - A pluggable LLMOps toolkit for TypeScript teams",
  "license": "Apache-2.0",
  "homepage": "https://llmops.build",
  "bugs": {
    "url": "https://github.com/llmops-build/llmops/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llmops-build/llmops.git",
    "directory": "packages/cli"
  },
  "author": "chtushar",
  "private": true,
  "scripts": {
    "dev": "bun run --conditions=browser ./src/index.ts",
    "build": "bun run script/build.ts",
    "build:single": "bun run script/build.ts --single",
    "publish:dry": "bun run script/publish.ts --dry",
    "clean": "rm -rf dist",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llmops",
    "cli",
    "ai",
    "llm",
    "typescript"
  ],
  "dependencies": {
    "@drizzle-team/brocli": "^0.11.0",
    "@llmops/core": "workspace:^",
    "@llmops/sdk": "workspace:^",
    "@opentui/core": "^0.1.97",
    "chalk": "^5.6.2",
    "esbuild": "^0.25.0",
    "kysely": "^0.28.8",
    "prompts": "^2.4.2",
    "yocto-spinner": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.15.6",
    "@types/prompts": "^2.4.9",
    "pg": "^8.16.3"
  }
}
