{
  "name": "llmops-monorepo",
  "version": "1.0.0",
  "description": "A pluggable LLMOps toolkit for TypeScript teams",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llmops-build/llmops.git"
  },
  "homepage": "https://llmops.build",
  "bugs": {
    "url": "https://github.com/llmops-build/llmops/issues"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter './packages/*' run build",
    "build:all": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:packages": "pnpm --filter './packages/*' --parallel run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "pnpm -r run clean",
    "release": "bumpp"
  },
  "keywords": [
    "llmops",
    "ai",
    "llm",
    "typescript",
    "openai"
  ],
  "author": "chtushar",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "^24.10.4",
    "bumpp": "^10.3.2",
    "nodemon": "^3.1.11",
    "tinyglobby": "^0.2.15",
    "tsdown": "0.17.0-beta.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "zod": "^4.3.5"
  }
}
